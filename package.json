{
  "name": "@mohanvadivel/n8n-nodes-zoho-desk",
  "version": "1.1.0",
  "description": "Zoho Desk community nodes for n8n.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "zoho",
    "zoho-desk",
    "helpdesk",
    "tickets",
    "crm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/imohanvadivel/n8n-nodes-zoho-desk",
  "author": {
    "name": "mohanvadivel",
    "email": "mohan@mohanvadivel.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imohanvadivel/n8n-nodes-zoho-desk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "n8n-node build && rsync -am --include='*/' --include='*.node.json' --exclude='*' nodes/ dist/nodes/",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "test": "bun test",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/asset"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/ZohoDeskOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZohoDesk/ZohoDesk.node.js",
      "dist/nodes/ZohoDeskTrigger/ZohoDeskTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.42.0",
    "@types/bun": "^1.2.0",
    "eslint": "^9.39.4",
    "n8n-workflow": "^2.13.0",
    "release-it": "^20.2.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
